---
// Contenedor de una unidad 3D. El modelo low-poly lo arma y anima
// src/scripts/units3d.ts a partir de estos data-atributos.
interface Props {
  team?: "a" | "b" | "tie";
  size?: number;
  hat?: "none" | "crown" | "helmet" | "straw" | "viking";
  weapon?: "none" | "sword" | "club" | "scroll" | "flag";
  mood?: "happy" | "sad" | "wow" | "angry";
  idle?: "wobble" | "walk" | "pull";
  // con su propio WebGL y a la frecuencia de la pantalla (para las del hero)
  solo?: boolean;
  class?: string;
}

const {
  team = "a",
  size = 90,
  hat = "none",
  weapon = "none",
  mood = "happy",
  idle = "wobble",
  solo = false,
  class: extra,
} = Astro.props;
---

<span
  class:list={["unit", extra]}
  style={`--size:${Math.round(size * 1.5)}px`}
  data-unit
  data-team={team}
  data-hat={hat}
  data-weapon={weapon}
  data-mood={mood}
  data-idle={idle}
  data-solo={solo ? "" : undefined}
  role="img"
  aria-label={`Unidad del equipo ${team.toUpperCase()}`}
>
  <canvas></canvas>
</span>

<style>
  .unit {
    display: inline-block;
    width: var(--size);
    aspect-ratio: 100 / 115;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    /* se renderiza a 1 pixel por pixel CSS: en pantallas retina se agranda
       con pixeles duros (estilo PS1) en vez de verse borroso */
    image-rendering: pixelated;
  }
</style>
