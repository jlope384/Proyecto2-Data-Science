---
interface Props {
  src: string;
  alt: string;
  caption: string;
  narrow?: boolean;
  tilt?: number;
}

const { src, alt, caption, narrow = false, tilt = -1 } = Astro.props;
---

<figure class:list={["fig", { narrow }]} style={`--tilt:${tilt}deg`} data-fig>
  <div class="frame panel bg-wood">
    <span class="tape" aria-hidden="true"></span>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .fig {
    margin: 2.8rem 0;
  }

  .fig.narrow {
    max-width: 480px;
    margin-inline: auto;
  }

  .frame {
    position: relative;
    padding: 12px;
    opacity: 0;
    transform: translateY(70px) rotate(calc(var(--tilt) * -6)) scale(0.85);
    transition:
      opacity 0.4s var(--ease),
      transform 0.9s var(--pop);
  }

  .frame:hover {
    transform: rotate(0deg) scale(1.02);
  }

  .tape {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 110px;
    height: 26px;
    margin-left: -55px;
    background: rgb(255 200 61 / 0.85);
    border: 2px solid rgb(35 32 46 / 0.25);
    rotate: -3deg;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  figcaption {
    margin: 1rem auto 0;
    max-width: 90%;
    text-align: center;
    font-size: 0.92rem;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.6s var(--ease) 0.4s;
  }

  .fig:global(.is-visible) .frame {
    opacity: 1;
    transform: rotate(var(--tilt));
  }

  .fig:global(.is-visible) .frame:hover {
    transform: rotate(0deg) scale(1.02);
  }

  .fig:global(.is-visible) figcaption {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    figcaption {
      opacity: 1;
      transform: rotate(var(--tilt));
    }
  }
</style>
