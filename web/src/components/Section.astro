---
interface Props {
  id: string;
  num: string;
  kicker: string;
  title: string;
}

const { id, num, kicker, title } = Astro.props;
---

<section id={id} class="section">
  <header class="head">
    <span class="badge" data-reveal="pop">
      <small>Nivel</small>
      {num}
    </span>
    <div>
      <p class="kicker" data-reveal style="--i:1">{kicker}</p>
      <h2 data-reveal style="--i:2">{title}</h2>
    </div>
  </header>
  <slot />
</section>

<style>
  .section {
    padding: 16vh 0 2vh;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 2rem;
  }

  .badge {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    align-content: center;
    width: 78px;
    height: 78px;
    font-family: var(--display);
    font-size: 2rem;
    line-height: 0.9;
    color: var(--ink);
    background: var(--gold);
    border: 3px solid var(--ink);
    border-radius: 22px;
    box-shadow: 0 5px 0 var(--ink);
    rotate: -6deg;
  }

  .badge:global(.is-visible) {
    animation: badge-wiggle 3s ease-in-out 1s infinite;
  }

  .badge small {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .kicker {
    font-family: var(--display);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--b-dark);
    margin: 0 0 0.3rem;
  }

  h2 {
    font-size: clamp(1.9rem, 6vw, 2.7rem);
    text-shadow: 3px 3px 0 #fff;
  }

  @keyframes badge-wiggle {
    0%,
    80%,
    100% {
      rotate: -6deg;
    }
    85% {
      rotate: 6deg;
    }
    90% {
      rotate: -10deg;
    }
    95% {
      rotate: 3deg;
    }
  }
</style>
