---
// Separador de cada una de las 5 partes de la presentación ("mundos" del juego)
interface Props {
  id: string;
  num: number;
  title: string;
}

const { id, num, title } = Astro.props;
---

<div id={id} class="world" data-world>
  <div class="card" data-reveal="pop">
    <span class="pips" aria-hidden="true">
      {[1, 2, 3, 4, 5].map((k) => <i class:list={{ on: k <= num }}></i>)}
    </span>
    <span class="label">Mundo {num} de 5</span>
    <h2>{title}</h2>
    <p><slot /></p>
  </div>
</div>

<style>
  .world {
    padding: 18vh 0 0;
    scroll-margin-top: 40px;
  }

  .card {
    position: relative;
    padding: 1.4rem 1.4rem 1.2rem;
    text-align: center;
    color: #fff;
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.08) 0 18px, transparent 18px 36px),
      var(--a-dark);
    border: 3px solid var(--ink);
    border-radius: 22px;
    box-shadow: 0 8px 0 var(--ink);
  }

  .pips {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-bottom: 0.6rem;
  }

  .pips i {
    width: 16px;
    height: 16px;
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.35);
  }

  .pips i.on {
    background: var(--gold);
  }

  .label {
    font-family: var(--display);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }

  h2 {
    margin: 0.2rem 0 0.5rem;
    font-size: clamp(2.1rem, 8vw, 3.2rem);
    text-shadow:
      3px 0 0 var(--ink),
      -3px 0 0 var(--ink),
      0 3px 0 var(--ink),
      0 -3px 0 var(--ink),
      0 6px 0 var(--ink);
  }

  p {
    max-width: 32em;
    margin: 0 auto;
    font-size: 0.98rem;
    opacity: 0.95;
  }
</style>
