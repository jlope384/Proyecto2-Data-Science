---
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import World from "../components/World.astro";
import Section from "../components/Section.astro";
import Figure from "../components/Figure.astro";
import Unit from "../components/Unit.astro";
import LiveDemo from "../components/LiveDemo.astro";

// Del cuaderno notebooks/Modelado_ChatbotArena.ipynb (conjunto de prueba, 11,494 batallas)
const BASE = 1.0972;
const results = [
  { name: "LogReg TF-IDF + estructura", ll: 1.0414, acc: 47.3, best: true },
  { name: "HistGB (ajustado)", ll: 1.046, acc: 45.7 },
  { name: "HistGradientBoosting", ll: 1.047, acc: 45.6 },
  { name: "LogReg estructural", ll: 1.0654, acc: 43.4 },
  { name: "Línea base (prior)", ll: BASE, acc: 34.9 },
];
const maxGain = BASE - results[0].ll;

const pipeline = [
  { t: "Datos", d: "train.csv de Kaggle: 57,477 batallas → 57,470 tras quitar 7 duplicados. Sin faltantes. Se decodifica el JSON de cada turno." },
  { t: "EDA", d: "Sesgos del voto: verbosidad, formato y posición. Distribuciones de cola larga → medianas y escalas log." },
  { t: "Variables", d: "18 variables por batalla: longitud, palabras, formato y turnos, y sobre todo diferencias y razones A vs B." },
  { t: "Modelos", d: "scikit-learn: línea base, regresión logística, HistGradientBoosting (+ GridSearchCV) y TF-IDF + estructura calibrado." },
  { t: "Artefactos", d: "Modelos .joblib, tabla comparativa y predicciones sobre el conjunto de prueba." },
  { t: "Aplicación", d: "Streamlit carga los .joblib y predice en vivo. Esta página la incrusta y trae un respaldo en JavaScript." },
];

const decisions = [
  {
    d: "Log-loss multiclase como métrica principal",
    why: "Es la métrica de la competencia y evalúa probabilidades, no solo la clase: castiga la sobreconfianza. La referencia a vencer es ln(3) ≈ 1.099.",
  },
  {
    d: "Variables comparativas A vs B",
    why: "El voto es relativo: importa cuál es más larga o tiene más formato, no cuánto mide cada una. Además hace al modelo menos sensible a la posición.",
  },
  {
    d: "No usar la identidad del modelo",
    why: "Explica mucho (18.6%–76.0% de victorias), pero no viene en el set de prueba. Usarla sería una fuga de información.",
  },
];

const challenges = [
  {
    t: "El TF-IDF acertaba más… y perdía contra el azar",
    fix: "Tenía buena exactitud, pero su log-loss superaba la de la línea base: probabilidades sobreconfiadas. Con regularización fuerte (C = 0.3) y calibración sigmoide bajó a 1.041, el mejor resultado.",
    learn: "Con log-loss importa tanto qué tan seguro está el modelo como si acierta.",
  },
  {
    t: "El empate es la clase más difícil",
    fix: "Solo 25% de los empates se detecta (A y B, ~57%). El modelo casi nunca está seguro de un empate; la curva de calibración lo confirma.",
    learn: "Un empate depende de que ambas respuestas sean igual de buenas, y eso está en el contenido, no en la superficie.",
  },
  {
    t: "Señales débiles en texto libre",
    fix: "Ninguna variable de superficie pasa de |ρ| = 0.24 con el objetivo. Se pasó de valores absolutos a comparativos y luego se agregó TF-IDF.",
    learn: "Las variables de superficie dan un piso; para mejorar hay que representar el contenido.",
  },
  {
    t: "Datos con forma rara",
    fix: "Prompts y respuestas venían como listas JSON por turno, con respuestas nulas y longitudes de hasta 53,299 caracteres. Se decodificó por turno, se conservaron los nulos como indicador y se usaron medianas y escalas log.",
    learn: "Limpiar bien al inicio evitó rehacer variables en el modelado.",
  },
  {
    t: "Que la app diera lo mismo que el cuaderno",
    fix: "Se separó el preprocesamiento en un módulo compartido y se agregó un chequeo contra predicciones_prueba.csv. Para la página, los coeficientes de la LogReg se exportaron a JavaScript.",
    learn: "Un modelo solo es útil si se puede reproducir fuera del cuaderno.",
  },
  {
    t: "Costo contra ganancia",
    fix: "El TF-IDF tarda 83.5 s en entrenar contra 6.2 s del HistGB ajustado, para una mejora de 0.005 en log-loss.",
    learn: "La ganancia del texto existe pero es chica con bolsa de palabras: el siguiente salto pide embeddings o transformers.",
  },
];

const objectives = [
  "Medir qué tanto influyen la longitud, el formato y la posición en el voto.",
  "Ver si el formato influye por sí solo o solo porque alarga la respuesta.",
  "Comparar cuánto predicen las variables de superficie frente al contenido del texto.",
  "Entender cuándo hay empate y si se puede distinguir de una preferencia clara.",
  "Lograr probabilidades confiables y ver si un modelo más complejo vale su costo.",
];

const conclusions = [
  {
    t: "Los sesgos existen, pero con pesos muy distintos",
    d: "La verbosidad es el sesgo dominante: la respuesta más larga gana el 61.5 % de las batallas decididas, y la proporción crece de forma monótona con la razón de longitudes (de 49.5 % si son casi iguales a 68.7 % si una es 5 veces más larga). El sesgo de posición es real pero mínimo (A gana 50.5 % frente a 49.5 %, p = 0.038). Esto confirma con datos reales lo reportado por Zheng et al. (2023).",
  },
  {
    t: "El formato es en gran parte un reflejo de la longitud",
    d: "La respuesta con más markdown gana ~46 % frente a ~27 %, pero en los modelos su peso cae mucho al controlar por longitud: las respuestas con listas y negritas ganan sobre todo porque son más largas, no por el formato en sí.",
  },
  {
    t: "La superficie da el piso, el contenido es el techo",
    d: "Ninguna variable de superficie pasa de |ρ| = 0.24 con el voto. Aun así, solo con ellas la log loss baja de 1.0972 a 1.0654 (LogReg) o a 1.0460 (HistGB, con interacciones no lineales). Agregar el contenido con TF-IDF lleva a 1.0414: una mejora real pero chica, porque la bolsa de palabras no captura la calidad del razonamiento. La preferencia humana depende sobre todo de un contenido que requiere representaciones semánticas.",
  },
  {
    t: "El empate es la clase menos separable",
    d: "Los empates se concentran cuando las respuestas tienen longitudes parecidas (37.7 % con razón < 1.1 y 74.7 % si son idénticas) y bajan a ~25 % cuando una es mucho más larga. Ningún modelo los reconoce bien (exhaustividad de 0.05 a 0.34): un empate depende de que ambas respuestas sean igual de buenas, y eso no se ve en la superficie.",
  },
  {
    t: "Calibrar importa más que acertar; la complejidad rinde poco",
    d: "El modelo TF-IDF sin regularizar acertaba más pero tenía peor log loss que la línea base por sobreconfianza. Con regularización fuerte y calibración sigmoide pasó a ser el mejor, con probabilidades bien calibradas entre 0.1 y 0.45. Frente a HistGB, el TF-IDF tarda unas 13 veces más (83.5 s contra 6.2 s) para mejorar solo 0.005 en log loss: el siguiente salto exige otro tipo de representación, no más del mismo.",
  },
];

const futureWork = [
  "Modelo baseline con las variables ya derivadas (longitud, formato, turnos), evaluado con log-loss multiclase.",
  "Incorporar representación del contenido: TF-IDF y luego embeddings o fine-tuning de un transformer (DeBERTa, Gemma, etc.).",
  "Validación cruzada sin fuga de información entre filas que compartan prompt o modelos.",
  "Corregir/monitorear el sesgo de posición (promediar predicciones con A/B intercambiados).",
  "Tratar aparte las batallas con respuesta nula y las de same_model.",
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chatbot Arena · Proyecto 2</title>
    <meta
      name="description"
      content="Predicción de la preferencia humana en batallas de Chatbot Arena: problema, diseño, demo en vivo, retos y conclusiones — Grupo 5, UVG."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Nunito:wght@600;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="hp" aria-hidden="true">
      <span class="heart">♥</span>
      <div class="hp-bar"><i id="hp"></i><span>Progreso de campaña <b id="hp-pct">0%</b></span></div>
    </div>

    <main>
      <Hero />

      <!-- ================= Mundo 1 · Problema y objetivo ================= -->
      <World id="mundo-1" num={1} title="Problema y objetivo">
        Qué resolvimos y por qué importa.
      </World>

      <Section id="contexto" num="1-1" kicker="El campo de batalla" title="De benchmarks estáticos a preferencia humana">
        <p data-reveal>
          En <strong>Chatbot Arena</strong> (LMSYS), un usuario recibe dos respuestas
          anónimas a su prompt y vota cuál prefiere, o declara empate. Con millones de
          votos se construye un ranking tipo Elo, y esos votos alimentan el entrenamiento
          de <em>reward models</em> (RLHF).
        </p>
        <p data-reveal>
          El problema: recolectar votos humanos es costoso, y las personas votan con
          sesgos conocidos — <strong>verbosidad, formato y posición</strong>. Un modelo
          que anticipe el voto abarata la evaluación y deja ver esos sesgos.
        </p>
        <div class="mission panel bg-parchment" data-reveal="pop">
          <span class="chip">Misión principal</span>
          <p>
            Dado un prompt y dos respuestas, predecir qué preferirá un humano — A, B o
            empate — con probabilidades confiables.
          </p>
          <Unit team="a" size={64} hat="straw" weapon="flag" class="mission-unit" />
        </div>
      </Section>

      <Section id="objetivos" num="1-2" kicker="Objetivos de la misión" title="Qué buscamos">
        <p data-reveal>
          <strong>General:</strong> predecir cuál de dos respuestas de LLM prefiere la gente
          y saber si lo decide la forma o el contenido.
        </p>
        <ul class="quests" data-stagger>
          {objectives.map((o) => (
            <li class="bg-notebook" data-reveal="left"><span class="check"></span>{o}</li>
          ))}
        </ul>
      </Section>

      <!-- ================= Mundo 2 · Solución y diseño ================= -->
      <World id="mundo-2" num={2} title="Solución y diseño">
        Arquitectura, decisiones técnicas y el porqué de cada una.
      </World>

      <Section id="arquitectura" num="2-1" kicker="Mapa del mundo" title="De un CSV a modelos en vivo">
        <ol class="path" data-stagger>
          {
            pipeline.map((s) => (
              <li class="panel" data-reveal="left">
                <b>{s.t}</b>
                <span>{s.d}</span>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="sesgos" num="2-2" kicker="Lo que dijo el EDA" title="La respuesta más larga suele ganar">
        <p data-reveal>
          <strong>57,470 batallas</strong> y <strong>64 modelos</strong>. Las tres clases
          están casi igual de representadas:
        </p>
        <div class="score panel bg-field" data-anim>
          <div class="stack">
            <i style="--w:34.9%; --c:var(--a)"></i>
            <i style="--w:30.9%; --c:var(--tie)"></i>
            <i style="--w:34.2%; --c:var(--b)"></i>
          </div>
          <div class="team">
            <b><span data-count="34.9" data-decimals="1">0</span>%</b>
            <span>Gana A</span>
            <Unit team="a" size={64} hat="helmet" weapon="sword" />
          </div>
          <div class="team">
            <b><span data-count="30.9" data-decimals="1">0</span>%</b>
            <span>Empate</span>
            <Unit team="tie" size={64} hat="straw" mood="wow" />
          </div>
          <div class="team">
            <b><span data-count="34.2" data-decimals="1">0</span>%</b>
            <span>Gana B</span>
            <Unit team="b" size={64} hat="viking" weapon="club" mood="angry" />
          </div>
        </div>

        <div class="duel panel bg-field" data-anim>
          <div class="duelist">
            <Unit team="a" size={84} hat="crown" weapon="scroll" />
            <span class="name">El Verboso</span>
          </div>
          <div class="duel-score">
            <b class="big"><span data-count="61.5" data-decimals="1">0</span>%</b>
            <p>de las batallas decididas las gana la respuesta <strong>más larga</strong></p>
          </div>
          <div class="duelist">
            <Unit team="b" size={84} hat="straw" mood="sad" />
            <span class="note">ok.</span>
            <span class="name">El Breve</span>
          </div>
        </div>

        <div class="meters" data-anim>
          <div class="meter"><span>Más larga gana</span><i style="--w:61.5%; --c:var(--a)"></i><b>61.5%</b></div>
          <div class="meter"><span>…si es 5× más larga</span><i style="--w:68.7%; --c:var(--a-dark)"></i><b>68.7%</b></div>
          <div class="meter coin"><span>Lanzar una moneda</span><i style="--w:50%; --c:var(--tie)"></i><b>50%</b></div>
        </div>

        <h3 class="sub" data-reveal>Arma #2 · Formato markdown</h3>
        <p data-reveal>
          Listas, encabezados y negritas también ganan votos (va de la mano con la longitud).
        </p>
        <div class="meters" data-anim>
          <div class="meter"><span>Más formato</span><i style="--w:45.5%; --c:var(--a)"></i><b>~46%</b></div>
          <div class="meter"><span>Menos formato</span><i style="--w:26.5%; --c:var(--b)"></i><b>~27%</b></div>
        </div>

        <h3 class="sub" data-reveal>Arma #3 · La posición</h3>
        <div class="tug panel bg-field" data-anim>
          <div class="tug-score">
            <b class="ta">A · 50.5%</b>
            <span>p = 0.038</span>
            <b class="tb">49.5% · B</b>
          </div>
          <div class="tug-field">
            <div class="crew crew-a">
              <Unit team="a" size={40} idle="pull" />
              <Unit team="a" size={40} idle="pull" />
              <Unit team="a" size={40} idle="pull" />
            </div>
            <div class="rope-wrap">
              <span class="rope"></span>
              <span class="flag"></span>
            </div>
            <span class="midline"></span>
            <div class="crew crew-b">
              <Unit team="b" size={40} idle="pull" />
              <Unit team="b" size={40} idle="pull" />
              <Unit team="b" size={40} idle="pull" />
            </div>
          </div>
        </div>
        <p data-reveal>
          Real pero leve: ~1 punto, mucho menor que el efecto de la longitud. Y ninguna
          variable de superficie pasa de <strong>|ρ| = 0.24</strong> con el objetivo:
          para ganar hay que leer el contenido.
        </p>
      </Section>

      <Section id="decisiones" num="2-3" kicker="Árbol de habilidades" title="Decisiones técnicas y por qué">
        <ul class="skills" data-stagger>
          {
            decisions.map((x) => (
              <li class="panel" data-reveal="left">
                <b>{x.d}</b>
                <span><em>¿Por qué?</em> {x.why}</span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="resultados" num="2-4" kicker="Tabla de puntuaciones" title="El texto gana, por poco">
        <p data-reveal>
          Log-loss en el conjunto de prueba (11,494 batallas). La barra es cuánto mejora
          cada modelo sobre la línea base; menor log-loss es mejor.
        </p>
        <div class="board panel bg-grid" data-anim>
          {
            results.map((r) => (
              <div class:list={["row", { best: r.best }]}>
                <span class="who">
                  {r.best && <span class="chip">MVP</span>}
                  {r.name}
                </span>
                <i style={`--w:${Math.max(2, ((BASE - r.ll) / maxGain) * 100)}%`}></i>
                <span class="nums">
                  <b>{r.ll.toFixed(3)}</b> log-loss · {r.acc.toFixed(1)}% exactitud
                </span>
              </div>
            ))
          }
        </div>
        <Figure
          src="/figs/matriz_confusion.png"
          alt="Matriz de confusión del modelo TF-IDF + estructura"
          caption="Acierta 58% de las victorias de A y 56% de las de B, pero solo 25% de los empates."
          narrow
        />
        <Figure
          src="/figs/importancia_variables.png"
          alt="Coeficientes de la regresión logística estructural"
          caption="len_diff y len_ratio dominan: el modelo aprendió el sesgo de verbosidad que mostró el EDA."
          narrow
          tilt={1.5}
        />
        <Figure
          src="/figs/calibracion.png"
          alt="Curva de calibración del modelo TF-IDF + estructura"
          caption="Probabilidades bien calibradas entre 0.1 y 0.45; arriba de eso el modelo se queda corto de confianza."
          narrow
        />
      </Section>

      <!-- ================= Mundo 3 · Demo ================= -->
      <World id="mundo-3" num={3} title="Demo">
        El proyecto funcionando: los modelos entrenados, en vivo.
      </World>

      <Section id="demo" num="3-1" kicker="Arena de práctica" title="Escribe dos respuestas y que voten los modelos">
        <p data-reveal>
          La app de Streamlit carga los cuatro modelos, calcula las 18 variables al vuelo
          y muestra la predicción de cada uno y su consenso.
        </p>
        <LiveDemo />
      </Section>

      <!-- ================= Mundo 4 · Retos y aprendizajes ================= -->
      <World id="mundo-4" num={4} title="Retos y aprendizajes">
        Lo que más nos costó y cómo lo resolvimos.
      </World>

      <Section id="retos" num="4-1" kicker="Jefes de nivel" title="Lo que más costó">
        <ol class="bosses" data-stagger>
          {
            challenges.map((c) => (
              <li class="panel" data-reveal="left">
                <b>{c.t}</b>
                <p>{c.fix}</p>
                <p class="learn">
                  <span class="chip">Aprendizaje</span> {c.learn}
                </p>
              </li>
            ))
          }
        </ol>
      </Section>

      <!-- ================= Mundo 5 · Conclusiones ================= -->
      <World id="mundo-5" num={5} title="Conclusiones y trabajo futuro">
        Qué logramos y cuál es la próxima campaña.
      </World>

      <Section id="conclusiones" num="5-1" kicker="Resumen de batalla" title="Conclusiones">
        <div class="victory" data-anim id="victory">
          <div class="confetti" aria-hidden="true"></div>
          <h2 class="victory-title">¡Victoria!<small>(matizada)</small></h2>
          <div class="victory-units" aria-hidden="true">
            <Unit team="a" size={64} hat="helmet" weapon="flag" />
            <Unit team="tie" size={64} hat="straw" mood="wow" />
            <Unit team="b" size={64} hat="viking" weapon="club" />
          </div>
          <div class="answer panel bg-parchment">
            <span class="chip">¿Se puede predecir la preferencia humana?</span>
            <p>
              Sí, mejor que el azar: log-loss de 1.097 a 1.041 y 47.3% de exactitud. Los
              sesgos se confirman, pero la superficie no basta — la preferencia depende
              sobre todo del <em>contenido</em>.
            </p>
          </div>
        </div>

        <ol class="campaign" data-stagger>
          {conclusions.map((c) => (
            <li data-reveal="left"><strong>{c.t}.</strong> {c.d}</li>
          ))}
        </ol>
      </Section>

      <Section id="trabajo-futuro" num="5-2" kicker="Próxima campaña" title="Trabajo futuro">
        <ol class="campaign" data-stagger>
          {futureWork.map((s) => <li data-reveal="left">{s}</li>)}
        </ol>
      </Section>

      <footer class="refs">
        <h3 data-reveal>Referencias</h3>
        <ul data-stagger>
          <li data-reveal>
            Chiang, W.-L. et al. (2024). <i>Chatbot Arena: An Open Platform for Evaluating
            LLMs by Human Preference.</i> ICML.{" "}
            <a href="https://arxiv.org/abs/2403.04132">arXiv:2403.04132</a>
          </li>
          <li data-reveal>
            Zheng, L. et al. (2023). <i>Judging LLM-as-a-Judge with MT-Bench and Chatbot
            Arena.</i> NeurIPS. <a href="https://arxiv.org/abs/2306.05685">arXiv:2306.05685</a>
          </li>
          <li data-reveal>
            Kaggle. <i>LMSYS – Chatbot Arena Human Preference Predictions.</i>{" "}
            <a href="https://www.kaggle.com/competitions/lmsys-chatbot-arena">kaggle.com</a>
          </li>
        </ul>
        <div class="bye" data-reveal="pop">
          <p>¡Gracias por jugar!</p>
          <a class="btn btn-blue" href="#">↺ Volver a jugar</a>
        </div>
        <p class="hint">Psst: haz click en cualquier unidad.</p>
      </footer>
    </main>

    <style>
      .sub {
        font-size: 1.6rem;
        margin: 3.5rem 0 0.8rem;
      }

      .big {
        font-family: var(--display);
        font-weight: 400;
        font-size: clamp(2.8rem, 11vw, 4rem);
        line-height: 1;
        font-variant-numeric: tabular-nums;
      }

      /* misión */
      .mission {
        position: relative;
        margin: 2.5rem 0 1rem;
        padding: 1.6rem;
        padding-right: 90px;
        rotate: -1deg;
      }

      .mission p {
        margin: 0.8rem 0 0;
        font-family: var(--display);
        font-size: 1.35rem;
        line-height: 1.3;
      }

      .mission :global(.mission-unit) {
        position: absolute;
        right: 14px;
        bottom: -10px;
      }

      /* objetivos */
      .quests {
        list-style: none;
        padding: 0;
        margin: 1.5rem 0;
      }

      .quests li {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        margin-bottom: 12px;
        padding: 0.9rem 1rem;
        border: 3px solid var(--ink);
        border-radius: 14px;
        box-shadow: 0 4px 0 var(--ink);
      }

      .check {
        position: relative;
        flex: 0 0 auto;
        width: 28px;
        height: 28px;
        margin-top: 1px;
        border: 3px solid var(--ink);
        border-radius: 8px;
        background: #fff;
      }

      .check::after {
        content: "";
        position: absolute;
        left: 7px;
        top: 1px;
        width: 8px;
        height: 15px;
        border: solid var(--grass-dark);
        border-width: 0 5px 5px 0;
        rotate: 45deg;
        scale: 0;
        transition: scale 0.5s var(--pop);
        transition-delay: calc(var(--i, 0) * 110ms + 0.5s);
      }

      li:global(.is-visible) .check::after {
        scale: 1;
      }

      /* marcador */
      .score {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin: 1.5rem 0 2rem;
        padding: 1.2rem 1rem 0.6rem;
        text-align: center;
      }

      .team {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .team b {
        font-family: var(--display);
        font-weight: 400;
        font-size: 1.9rem;
        line-height: 1.1;
      }

      .team > span {
        font-size: 0.85rem;
        color: var(--muted);
      }

      .stack {
        grid-column: 1 / -1;
        display: flex;
        height: 22px;
        margin-bottom: 0.6rem;
        border: 3px solid var(--ink);
        border-radius: 999px;
        overflow: hidden;
        background: #fff;
      }

      .stack i {
        flex: 0 0 var(--w);
        background: var(--c);
        transform: scaleY(0);
        transition: transform 0.6s var(--pop);
      }

      .stack i + i {
        border-left: 3px solid var(--ink);
      }

      .stack i:nth-child(2) {
        transition-delay: 0.15s;
      }

      .stack i:nth-child(3) {
        transition-delay: 0.3s;
      }

      .score:global(.is-visible) .stack i {
        transform: none;
      }

      /* duelo verboso vs breve */
      .duel {
        display: grid;
        grid-template-columns: 1fr 1.3fr 1fr;
        align-items: end;
        gap: 10px;
        padding: 1.4rem 1rem 0.5rem;
        text-align: center;
      }

      .duelist {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .name {
        font-family: var(--display);
        font-size: 1rem;
        margin-top: -0.2rem;
        color: #fff;
        text-shadow:
          2px 0 0 var(--ink),
          -2px 0 0 var(--ink),
          0 2px 0 var(--ink),
          0 -2px 0 var(--ink);
      }

      .note {
        position: absolute;
        top: 58%;
        right: 62%;
        padding: 0 6px;
        font-size: 0.75rem;
        background: #fff;
        border: 3px solid var(--ink);
        border-radius: 6px;
      }

      .duel-score {
        align-self: center;
      }

      .duel-score {
        align-self: start;
      }

      .duel-score p {
        margin: 0.5rem 0 4.4rem;
        padding: 0.4rem 0.7rem;
        font-size: 0.9rem;
        line-height: 1.35;
        background: rgb(255 250 240 / 0.9);
        border: 3px solid var(--ink);
        border-radius: 12px;
      }

      /* barras tipo stat de unidad */
      .meters {
        display: grid;
        gap: 12px;
        margin: 1.8rem 0 2rem;
      }

      .meter {
        display: grid;
        grid-template-columns: 9.5rem 1fr 3.6rem;
        align-items: center;
        gap: 12px;
        font-size: 0.9rem;
      }

      .meter i {
        position: relative;
        height: 20px;
        border: 3px solid var(--ink);
        border-radius: 999px;
        background: #fff;
        overflow: hidden;
      }

      .meter i::before {
        content: "";
        position: absolute;
        inset: 0;
        width: var(--w);
        background: var(--c);
        border-right: 3px solid var(--ink);
        box-shadow: inset 0 -5px 0 rgb(0 0 0 / 0.18);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 1.1s var(--pop);
      }

      .meter:nth-child(2) i::before {
        transition-delay: 0.15s;
      }

      .meter:nth-child(3) i::before {
        transition-delay: 0.3s;
      }

      .meters:global(.is-visible) i::before {
        transform: none;
      }

      .meter b {
        font-family: var(--display);
        font-weight: 400;
        font-size: 1.15rem;
      }

      .coin span,
      .coin b {
        color: var(--muted);
      }

      /* tira y afloja */
      .tug {
        margin: 1.5rem 0;
        padding: 0.8rem 1rem 0.4rem;
        overflow: hidden;
      }

      .tug-field {
        position: relative;
        height: 100px;
      }

      .crew {
        position: absolute;
        bottom: 0;
        display: flex;
        gap: 2px;
        z-index: 2;
      }

      .crew-a {
        left: 0;
        rotate: -14deg;
        transform-origin: bottom left;
        animation: pull-a 0.7s ease-in-out infinite alternate;
      }

      .crew-b {
        right: 0;
        rotate: 14deg;
        transform-origin: bottom right;
        animation: pull-b 0.7s ease-in-out infinite alternate;
      }

      .crew-b :global(.unit) {
        scale: -1 1;
      }

      .rope-wrap {
        position: absolute;
        left: 12%;
        right: 12%;
        top: 42px;
        height: 30px;
        animation: tug 1.4s ease-in-out infinite alternate;
      }

      .rope {
        position: absolute;
        left: 0;
        right: 0;
        top: 12px;
        height: 7px;
        border-radius: 4px;
        background: repeating-linear-gradient(60deg, #c58b4a 0 6px, #9a6631 6px 12px);
        border: 2px solid var(--ink);
      }

      .flag {
        position: absolute;
        left: 50%;
        top: -14px;
        width: 4px;
        height: 34px;
        background: var(--ink);
        transition: left 2s var(--pop) 0.4s;
      }

      .flag::after {
        content: "";
        position: absolute;
        left: 4px;
        top: 0;
        border-left: 22px solid var(--gold);
        border-top: 8px solid transparent;
        border-bottom: 8px solid transparent;
        filter: drop-shadow(1px 0 0 var(--ink)) drop-shadow(0 1px 0 var(--ink));
      }

      .tug:global(.is-visible) .flag {
        left: 49.5%;
      }

      .midline {
        position: absolute;
        left: 50%;
        top: 0;
        bottom: 0;
        border-left: 3px dashed rgb(35 32 46 / 0.35);
      }

      .tug-score {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.4rem;
        font-size: 0.85rem;
        color: var(--muted);
      }

      .tug-score b {
        font-family: var(--display);
        font-weight: 400;
        font-size: 1.2rem;
      }

      .ta {
        color: var(--a-dark);
      }

      .tb {
        color: var(--b-dark);
      }

      /* mapa: arquitectura en pasos verticales */
      .path {
        list-style: none;
        counter-reset: step;
        padding: 0;
        margin: 1.5rem 0;
      }

      .path li {
        counter-increment: step;
        position: relative;
        display: grid;
        gap: 2px;
        margin: 0 0 34px;
        padding: 0.9rem 1rem 0.9rem 4rem;
      }

      .path li::before {
        content: counter(step);
        position: absolute;
        left: 12px;
        top: 50%;
        translate: 0 -50%;
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        font-family: var(--display);
        font-size: 1.2rem;
        background: var(--gold);
        border: 3px solid var(--ink);
        border-radius: 50%;
      }

      /* flecha hacia el siguiente paso */
      .path li:not(:last-child)::after {
        content: "▼";
        position: absolute;
        left: 50%;
        bottom: -31px;
        translate: -50% 0;
        font-size: 1.1rem;
        color: var(--ink);
      }

      .path li:last-child {
        margin-bottom: 0;
        background: var(--sky-light);
      }

      .path b,
      .skills b,
      .bosses b {
        font-family: var(--display);
        font-weight: 400;
        font-size: 1.25rem;
        line-height: 1.2;
      }

      .path span {
        font-size: 0.92rem;
      }

      /* decisiones técnicas */
      .skills,
      .bosses {
        list-style: none;
        padding: 0;
        margin: 1.5rem 0;
        display: grid;
        gap: 16px;
      }

      .skills li {
        display: grid;
        gap: 6px;
        padding: 1rem 1.1rem;
        border-left-width: 10px;
        border-left-color: var(--a);
      }

      .skills span {
        font-size: 0.93rem;
      }

      .skills em {
        font-style: normal;
        font-weight: 900;
        color: var(--b-dark);
      }

      /* tabla de puntuaciones */
      .board {
        display: grid;
        gap: 16px;
        margin: 1.5rem 0 2rem;
        padding: 1.2rem 1.1rem;
      }

      .row {
        display: grid;
        gap: 6px;
      }

      .who {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 900;
      }

      .row i {
        position: relative;
        height: 20px;
        border: 3px solid var(--ink);
        border-radius: 999px;
        background: #fff;
        overflow: hidden;
      }

      .row i::before {
        content: "";
        position: absolute;
        inset: 0;
        width: var(--w);
        background: var(--tie);
        border-right: 3px solid var(--ink);
        box-shadow: inset 0 -5px 0 rgb(0 0 0 / 0.18);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 1.1s var(--pop);
      }

      .row.best i::before {
        background: var(--grass);
      }

      .board:global(.is-visible) .row i::before {
        transform: none;
      }

      .nums {
        font-size: 0.85rem;
        color: var(--muted);
      }

      .nums b {
        font-family: var(--display);
        font-weight: 400;
        font-size: 1.15rem;
        color: var(--ink);
      }

      /* retos */
      .bosses {
        counter-reset: boss;
      }

      .bosses li {
        counter-increment: boss;
        padding: 1rem 1.1rem;
        border-left-width: 10px;
        border-left-color: var(--b);
      }

      .bosses b::before {
        content: "Jefe " counter(boss) " · ";
        color: var(--b-dark);
      }

      .bosses p {
        margin: 0.5rem 0 0;
        font-size: 0.93rem;
      }

      .bosses .learn {
        padding-top: 0.5rem;
        border-top: 3px dashed rgb(35 32 46 / 0.2);
      }

      /* victoria */
      .victory {
        position: relative;
        margin: 4rem 0 1rem;
        text-align: center;
      }

      .confetti {
        position: absolute;
        inset: -40px -10px auto;
        height: 0;
        pointer-events: none;
      }

      .confetti :global(i) {
        position: absolute;
        top: 0;
        width: 10px;
        height: 16px;
        border: 2px solid var(--ink);
        border-radius: 2px;
        animation: confetti 2.6s cubic-bezier(0.2, 0.6, 0.4, 1) forwards;
      }

      .victory-title {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        font-size: clamp(3.2rem, 14vw, 5.5rem);
        color: var(--gold);
        text-shadow:
          3px 0 0 var(--ink),
          -3px 0 0 var(--ink),
          0 3px 0 var(--ink),
          0 -3px 0 var(--ink),
          2px 2px 0 var(--ink),
          -2px -2px 0 var(--ink),
          2px -2px 0 var(--ink),
          -2px 2px 0 var(--ink),
          0 9px 0 var(--ink);
        transform: scale(0) rotate(-12deg);
        transition: transform 0.9s var(--pop);
      }

      .victory-title small {
        font-size: 0.32em;
        color: #fff;
        margin-top: 0.3em;
        text-shadow:
          2px 0 0 var(--ink),
          -2px 0 0 var(--ink),
          0 2px 0 var(--ink),
          0 -2px 0 var(--ink),
          0 4px 0 var(--ink);
      }

      .victory:global(.is-visible) .victory-title {
        transform: rotate(-3deg);
      }

      .victory-units {
        display: flex;
        justify-content: center;
        gap: 14px;
        margin: 1rem 0 0.4rem;
      }

      .victory:global(.is-visible) .victory-units :global(.unit) {
        animation: cheer 0.6s ease-in-out infinite alternate;
      }

      .victory-units :global(.unit:nth-child(2)) {
        animation-delay: 0.2s !important;
      }

      .victory-units :global(.unit:nth-child(3)) {
        animation-delay: 0.4s !important;
      }

      .answer {
        padding: 1.4rem 1.4rem 1.2rem;
        text-align: left;
      }

      .answer p {
        margin: 0.8rem 0 0;
        font-family: var(--display);
        font-size: 1.3rem;
        line-height: 1.3;
      }

      /* próxima campaña */
      .campaign {
        list-style: none;
        counter-reset: c;
        padding: 0;
        margin: 1.4rem 0;
      }

      .campaign li {
        counter-increment: c;
        position: relative;
        margin-bottom: 14px;
        padding: 0.2rem 0 0 3.4rem;
        min-height: 44px;
      }

      .campaign li::before {
        content: counter(c);
        position: absolute;
        left: 0;
        top: 0;
        display: grid;
        place-items: center;
        width: 40px;
        height: 44px;
        font-family: var(--display);
        font-size: 1.2rem;
        color: #fff;
        background: var(--a);
        border: 3px solid var(--ink);
        border-radius: 10px 10px 20px 20px;
        box-shadow: 0 3px 0 var(--ink);
      }

      /* referencias */
      .refs {
        padding: 14vh 0 8vh;
        font-size: 0.9rem;
        color: var(--muted);
      }

      .refs h3 {
        font-size: 1.3rem;
        color: var(--ink);
        margin-bottom: 0.8rem;
      }

      .refs ul {
        padding-left: 1.1rem;
      }

      .refs li {
        margin-bottom: 0.6rem;
      }

      .refs a {
        color: var(--a-dark);
      }

      .refs .btn {
        color: #fff;
      }

      .bye {
        margin-top: 10vh;
        text-align: center;
      }

      .bye p {
        font-family: var(--display);
        font-size: clamp(2rem, 8vw, 3rem);
        color: var(--ink);
        margin-bottom: 1rem;
      }

      .btn-blue {
        background: var(--a);
        box-shadow:
          inset 0 -6px 0 var(--a-dark),
          0 6px 0 var(--ink);
      }

      .hint {
        margin-top: 2.5rem;
        text-align: center;
        font-size: 0.8rem;
        opacity: 0.7;
      }

      /* ---------- keyframes ---------- */
      @keyframes pull-a {
        to {
          translate: -6px 0;
          rotate: -18deg;
        }
      }

      @keyframes pull-b {
        to {
          translate: 5px 0;
          rotate: 17deg;
        }
      }

      @keyframes tug {
        from {
          transform: translateX(-7px);
        }
        to {
          transform: translateX(4px);
        }
      }

      @keyframes shiver {
        0% {
          translate: -1px 0;
        }
        50% {
          translate: 1px 0;
        }
        100% {
          translate: -1px 0;
        }
      }

      @keyframes spin-in {
        from {
          transform: scale(0) rotate(-180deg);
        }
      }

      @keyframes cheer {
        from {
          transform: translateY(0);
        }
        to {
          transform: translateY(-22px) rotate(-6deg);
        }
      }

      @keyframes confetti {
        0% {
          transform: translate(0, 0) rotate(0);
          opacity: 1;
        }
        100% {
          transform: translate(var(--dx), var(--dy)) rotate(var(--r));
          opacity: 0;
        }
      }

      @media (max-width: 560px) {
        .meter {
          grid-template-columns: 6.8rem 1fr 3.2rem;
          font-size: 0.82rem;
        }
        .duel {
          grid-template-columns: 1fr 1fr;
        }
        .duel-score {
          grid-column: 1 / -1;
          grid-row: 1;
          margin-bottom: 0.8rem;
        }
        .duel-score p {
          margin-bottom: 0.4rem;
        }
        .crew {
          scale: 0.72;
        }
        .mission {
          padding-right: 1.6rem;
          padding-bottom: 4.2rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .stack i,
        .meter i::before,
        .row i::before,
        .victory-title {
          transform: none;
        }
        .check::after {
          scale: 1;
        }
        .flag {
          left: 49.5%;
        }
      }
    </style>

    <script>
      // Unidades 3D low-poly (ojos que siguen al cursor, ragdoll al hacer click)
      import "../scripts/units3d";

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Escalonar la entrada de los hijos de cada lista
      document.querySelectorAll("[data-stagger]").forEach((list) => {
        [...list.children].forEach((el, i) => (el as HTMLElement).style.setProperty("--i", String(i)));
      });

      // Contadores que suben de 0 al valor final
      const fmt = (n: number, d: number) =>
        n.toLocaleString("en-US", { minimumFractionDigits: d, maximumFractionDigits: d });

      function countUp(el: HTMLElement) {
        const target = Number(el.dataset.count);
        const decimals = Number(el.dataset.decimals ?? 0);
        if (reduced) {
          el.textContent = fmt(target, decimals);
          return;
        }
        const duration = 1500;
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          // sobrepasa un poco y regresa, como todo en este simulador
          const eased = 1 - Math.pow(1 - t, 3) * Math.cos(t * Math.PI * 1.5);
          el.textContent = fmt(target * Math.min(eased, 1.04), decimals);
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = fmt(target, decimals);
        };
        requestAnimationFrame(tick);
      }

      // Confeti al llegar a la pantalla de victoria
      function confetti(box: Element) {
        if (reduced) return;
        const colors = ["var(--a)", "var(--b)", "var(--gold)", "var(--grass)", "#fff"];
        for (let k = 0; k < 60; k++) {
          const p = document.createElement("i");
          p.style.left = `${Math.random() * 100}%`;
          p.style.background = colors[k % colors.length];
          p.style.setProperty("--dx", `${(Math.random() - 0.5) * 200}px`);
          p.style.setProperty("--dy", `${200 + Math.random() * 380}px`);
          p.style.setProperty("--r", `${(Math.random() - 0.5) * 1080}deg`);
          p.style.animationDelay = `${Math.random() * 0.5}s`;
          box.appendChild(p);
        }
      }

      // Revelar elementos al entrar en pantalla
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            el.classList.add("is-visible");
            const counters = el.matches("[data-count]") ? [el] : [...el.querySelectorAll<HTMLElement>("[data-count]")];
            counters.forEach(countUp);
            if (el.id === "victory") confetti(el.querySelector(".confetti")!);
            io.unobserve(el);
          }
        },
        { threshold: 0.25, rootMargin: "0px 0px -8% 0px" },
      );

      document.querySelectorAll("[data-reveal], [data-fig], [data-anim]").forEach((el) => io.observe(el));

      // Barra de "HP" con el progreso de lectura
      const hp = document.getElementById("hp")!;
      const hpPct = document.getElementById("hp-pct")!;
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        const pct = max > 0 ? Math.min(100, Math.round((scrollY / max) * 100)) : 0;
        hp.style.width = `${pct}%`;
        hpPct.textContent = `${pct}%`;
      };
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
